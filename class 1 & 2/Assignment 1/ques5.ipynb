   "source": [
    "def solve(sen):\n",
    "    words = \"\"\n",
    "    for ch in sen:\n",
    "        if ch.isalnum():\n",
    "            words += ch.lower()\n",
    "\n",
    "    return words[::-1] == words\n",
    "\n",
    "print(solve(\"Was it a car or a cat I saw?\"))\n",
    "\n",
    "\n",
    "print(solve(\"Python is fun\"))\n"
   ]
  }
