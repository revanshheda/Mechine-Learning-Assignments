    "def test(data):\n",
    "    if(\"@\" not in data):\n",
    "        return \"invalid\"\n",
    "    else:\n",
    "        ans = data.split(\"@\")[1].split(\".\")[0].title()\n",
    "\n",
    "    return ans\n",
    "\n",
    "print(test(\"developer_99@microsoft.com\"))\n",
    "print(test(\"admin_at_website.org\"))\n",
    "\n",
    "\n",
    "\n",
    "\n"
   ]
