    "def function(code):\n",
    "   newcode = code.split(\"-\")\n",
    "   newcode = newcode[::-1]\n",
    "   ans = \" \".join(newcode)\n",
    "   return ans.upper()\n",
    "\n",
    "print(function(\"charlie-bravo-alpha\"))\n"
   ]
