   "source": [
    "def solve(data):\n",
    "    names = data.split(\";\")\n",
    "    for i in range (len(names)):\n",
    "        names[i] = names[i].strip().title()\n",
    "\n",
    "    ans = \", \".join(names)\n",
    "    return ans\n",
    "\n",
    "print(solve(\" john doe ; jAnE sMiTh;   ALAN tUrInG \"))\n",
    "\n",
    "\n",
    "    "
   ]
  }
