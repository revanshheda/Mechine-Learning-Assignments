    "def validate(user):\n",
    "    user = user.strip()\n",
    "    if len(user)>=5 and user.isalnum():\n",
    "        return user.lower()\n",
    "    else:\n",
    "        return \"invalid\"\n",
    "\n",
    "print(validate(\" CodeMaster99 \"))\n",
    "print(validate(\" Python_Dev \"))"
   ]
