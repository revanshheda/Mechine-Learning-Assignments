    "def solve(post):\n",
    "    words = post.split()\n",
    "    ans = []\n",
    "    for word in words:\n",
    "        if word[0]==\"#\":\n",
    "            ans.append(word[1:].lower())\n",
    "\n",
    "    return ans \n",
    "\n",
    "print(solve(\"Loving the SUNSET! #Nature #Sunset_Vibes #beautiful\"))"
   ]
  }
