   "source": [
    "def solve(text):\n",
    "    words = text.split()\n",
    "    for i in range(len(words)):\n",
    "        words[i] = words[i].strip().capitalize()\n",
    "\n",
    "    ans = \" \".join(words)\n",
    "    return ans\n",
    "\n",
    "print(solve( \" python is a very  powerful language \"))"
   ]
  }
