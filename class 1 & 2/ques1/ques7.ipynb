   "source": [
    "def solve(data):\n",
    "    files = data.split(\",\")\n",
    "    ans = []\n",
    "\n",
    "    for file in files:\n",
    "        ext = file.split(\".\")[-1].strip().upper()\n",
    "\n",
    "        if ext not in ans:\n",
    "            ans.append(ext)\n",
    "\n",
    "    return ans\n",
    "\n",
    "\n",
    "print(solve(\"ort.pdf, image.JPG, data.csv, notes.txt, photo.jpg\"))"
   ]
  }
 ],
